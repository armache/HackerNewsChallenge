{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/v0/",
    "BestStoryIdsCacheDuration": "00:01:00",
    "StoryItemCacheDuration": "00:05:00",
    "MaxConcurrentUpstreamRequests": 20
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0,
    "MaxConcurrentRequests": 50,
    "ConcurrencyQueueLimit": 20
  },
  "RequestTimeoutSeconds":  35
}
